        <!-- Messages -->
        <mxCell id="m1" value="1. Bấm Thanh toán" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="110" y="130" as="sourcePoint"/><mxPoint x="335" y="130" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m2" value="2. Tạo yêu cầu thanh toán (Sync API)" style="html=1;endArrow=block;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="335" y="180" as="sourcePoint"/><mxPoint x="560" y="180" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m3" value="3. Trả về VietQR / URL" style="html=1;endArrow=block;fontSize=11;strokeColor=#16a085;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="560" y="230" as="sourcePoint"/><mxPoint x="335" y="230" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m4" value="4. Sinh mã VietQR" style="html=1;endArrow=block;fontSize=11;strokeColor=#16a085;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="335" y="280" as="sourcePoint"/><mxPoint x="110" y="280" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m5" value="5. Quét mã &amp; thanh toán (ngoài hệ thống)" style="html=1;endArrow=block;dashed=1;fontSize=11;strokeColor=#7f8c8d;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="110" y="330" as="sourcePoint"/><mxPoint x="560" y="330" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m6" value="6. Async Webhook (kết quả thanh toán + HMAC-Signature header)" style="html=1;endArrow=block;fontSize=11;strokeColor=#2980b9;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="560" y="390" as="sourcePoint"/><mxPoint x="795" y="390" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m7" value="7. Consumer Worker xử lý (dequeue event)" style="html=1;endArrow=block;fontSize=11;strokeColor=#2980b9;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="795" y="440" as="sourcePoint"/><mxPoint x="1035" y="440" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- Bổ sung 1: HMAC verify self-call -->
        <mxCell id="note1" value="7a. [BỔ SUNG] Xác thực chữ ký HMAC-SHA256&#10;(so sánh X-Signature header với HMAC(payload, secret))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c0392b;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="1030" y="470" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m8fail" value="Nếu KHÔNG hợp lệ → reject 400 (Bad Signature), ghi AuditLog, KHÔNG gạch nợ, dừng xử lý" style="html=1;endArrow=block;dashed=1;fontSize=10;strokeColor=#c0392b;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1035" y="555" as="sourcePoint"/><mxPoint x="795" y="555" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="note2" value="8. Nếu hợp lệ: kiểm tra Idempotency Key (tránh xử lý trùng)&#10;→ Gạch nợ, cập nhật PaymentTransaction.status = PAID + ghi AuditLog (ACID)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eafaf1;strokeColor=#16a085;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="1030" y="580" width="280" height="65" as="geometry" />
        </mxCell>

        <mxCell id="m9" value="9. [BỔ SUNG] Cập nhật trạng thái đơn hàng (Shipment.status = PAID)" style="html=1;endArrow=block;fontSize=11;strokeColor=#c0392b;fontStyle=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1035" y="670" as="sourcePoint"/><mxPoint x="1275" y="670" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m10" value="10. ACK cập nhật thành công" style="html=1;endArrow=block;dashed=1;fontSize=11;strokeColor=#7f8c8d;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1275" y="710" as="sourcePoint"/><mxPoint x="1035" y="710" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m11" value="11. Ack message (loại khỏi hàng đợi)" style="html=1;endArrow=block;fontSize=11;strokeColor=#2980b9;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1035" y="750" as="sourcePoint"/><mxPoint x="795" y="750" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="note3" value="12. Xử lý COD: đối soát tự động → tạo bản ghi CODSettlement,&#10;chuyển tiền vào ví người gửi trong vòng 24h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4ecf7;strokeColor=#8e44ad;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="1030" y="780" width="280" height="55" as="geometry" />
        </mxCell>

        <mxCell id="title" value="Sơ đồ tuần tự — Giải pháp 2 (Async Webhook/Queue)&#10;Bổ sung: (7a) xác thực HMAC trước khi gạch nợ, (9) cập nhật trạng thái đơn hàng sau gạch nợ" style="text;html=1;fontSize=15;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="360" y="-40" width="700" height="60" as="geometry" />
        </mxCell>

